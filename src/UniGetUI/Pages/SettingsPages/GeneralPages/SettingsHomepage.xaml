<?xml version="1.0" encoding="utf-8" ?>
<Page
  x:Class="UniGetUI.Pages.SettingsPages.SettingsHomepage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="using:UniGetUI.Pages.SettingsPages"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:widgets="using:UniGetUI.Interface.Widgets"
  Background="Transparent"
  mc:Ignorable="d"
>
  <ScrollViewer
    x:Name="Scroller"
    Margin="0,0,-8,0"
    Padding="0,0,8,0"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Center"
    VerticalContentAlignment="Center"
    VerticalScrollBarVisibility="Hidden"
  >
    <StackPanel Name="SettingsEntries" Orientation="Vertical">
      <widgets:SettingsPageButton
        x:Name="GeneralSettingsExpander"
        Click="General"
        Icon="settings"
        Text="General"
        UnderText="Language, UniGetUI updater, backup and restore your settings"
      />
        
      <UserControl Height="16" />
        
      <widgets:SettingsPageButton
        x:Name="InterfaceSettingsExpander"
        Click="Interface"
        CornerRadius="8"
        Icon="interactive"
        Text="User interface"
        UnderText="Theme, system tray, package lists"
      />
        
       <UserControl Height="16" />
        
      <widgets:SettingsPageButton
        x:Name="NotificationSettingsEntry"
        Click="Notifications"
        CornerRadius="8"
        Icon="megaphone"
        Text="Notifications"
        UnderText="Event-based notifications"
      />

      <UserControl Height="16" />
       
      <widgets:SettingsPageButton
        x:Name="UpdatesOptionsExpander"
        Click="Operations"
        CornerRadius="8,8,0,0"
        Icon="Package"
        Text="Package operations"
        UnderText="Handling of install, update and uninstall operations"
      />

      <widgets:SettingsPageButton
        x:Name="StartupOptionsExpander"
        BorderThickness="1,0,1,1"
        Click="Startup"
        CornerRadius="0,0,8,8"
        Icon="update"
        Text="Package updates"
        UnderText="Package update check frequency, automatic install of package updates"
      />

      <UserControl Height="16" />

      <widgets:SettingsPageButton
        x:Name="BackupOptionsExpander"
        Click="Backup"
        CornerRadius="8"
        Icon="disk"
        Text="Package list backup"
        UnderText="Backup a list of your installed packages"
      />

      <UserControl Height="16" />

      <widgets:SettingsPageButton
        x:Name="ManagersSettingsShortcut"
        Click="ManagersShortcut"
        CornerRadius="8"
        Icon="Search"
        Text="Package manager configuration"
        UnderText="Enable and disable package managers, change default installation options"
      >
        <widgets:SettingsPageButton.HeaderIcon>
          <FontIcon FontSize="12" Glyph="&#xE835;" />
        </widgets:SettingsPageButton.HeaderIcon>
      </widgets:SettingsPageButton>

      <UserControl Height="16" />

      <widgets:SettingsPageButton
        x:Name="InternetSettings"
        Click="Internet"
        CornerRadius="8"
        Icon="Search"
        Text="Internet connection"
        UnderText="Proxy settings and internet waiting"
      >
        <widgets:SettingsPageButton.HeaderIcon>
          <FontIcon FontSize="12" Glyph="&#xE839;" />
        </widgets:SettingsPageButton.HeaderIcon>
      </widgets:SettingsPageButton>

       <UserControl Height="16" />

        <widgets:SettingsPageButton
        x:Name="AdminSettingsExpander"
        Click="Administrator"
        CornerRadius="8"
        Icon="uac"
        Text="Operational restrictions"
        UnderText="Package operation/manager restrictions, package bundle restrictions"
      />

       <UserControl Height="16" />
        
      <widgets:SettingsPageButton
        x:Name="ExperimentalSettingsExpander"
        Click="Experimental"
        CornerRadius="8"
        Icon="experimental"
        Text="Advanced"
        UnderText="Recommended for advanced users only"
      />

        <UserControl Height="16" />
        
    </StackPanel>
  </ScrollViewer>
</Page>
